<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.melin</groupId>
		<artifactId>lakehouse-rest-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>lakehouse-rest-optimizer</artifactId>
	<packaging>jar</packaging>
	<name>lakehouse-rest-optimizer</name>
	<description>表存储优化任务：在 k8s 上跑 Spark，按批次对多张 Paimon / Iceberg / Lance 表执行合并、快照清理与孤儿文件回收</description>

	<!--
		Iceberg 的版本由根 POM 的 `iceberg.version` 统一给出（与 lakehouse-rest-spark
		的测试依赖同一个值）。它**必须与 spring-parent 的 iceberg.version 一致**：
		服务端用 iceberg-core 写/读这份元数据，优化任务用 Spark bundle 执行 procedure，
		两边版本不一致时，新写入的元数据（例如 v3 的 next-row-id）可能被旧运行时读不懂。

		两个 POM 分属两个依赖世界（Spring Boot / 集群 Spark），没法共用一份属性，
		因此各声明一次；改了其中一个，另一个要同步。
	-->

	<!--
		这个模块是**一个可执行程序**，不是库：它由服务端作为 k8s Job 提交
		（见 lakehouse-rest-server 的 KubernetesJobSubmitter），启动后自己拉批次清单、
		建一次 Spark 会话、逐表执行三个 procedure、逐表回调上报结果，然后退出。

		依赖策略与 lakehouse-rest-spark 一致，理由也一致：
		  - Spark / Scala 由集群提供（spark-submit 的运行时），因此 scope=provided，
		    不打进产物——否则生成的 jar 会与集群里的 Spark 版本打架；
		  - JSON 用 Spark 自带的 Jackson 2；
		  - HTTP 只用 java.net.http，不引额外客户端。

		注意本模块**没有** Paimon 依赖：三个动作都通过 `CALL` 语句执行，而 procedure
		由 Paimon 自己的 Spark 扩展与 catalog 实现落地。也就是说本模块编译期不需要
		Paimon，运行时通过集群的 `spark.sql.catalog.<name>` 配置间接用到它。
		这条边界很重要：Paimon 的 procedure 参数签名随版本变（例如 `dry_run` 在不同
		版本的参数名不同），把它写在 SQL 里、由目标集群的 Paimon 去解释，比在这里
		依赖某个版本的 Java API 更稳。
	-->

	<dependencies>
		<dependency>
			<groupId>org.scala-lang</groupId>
			<artifactId>scala-library</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-sql_${scala.binary.version}</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-catalyst_${scala.binary.version}</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>

		<!--
			slf4j 与 lakehouse-rest-spark 同一处坑：传递依赖里有一份 1.7.x，
			而本模块按 2.x 的 SPI 写日志。用 provided 而不是 test——provided 同时进
			主类路径与测试运行时，既能让主编译拿到 Logger，又不把绑定打进产物
			（产物跑在集群上，绑定由 spark-submit 的 log4j2 提供）。
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.18</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>2.0.18</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Paimon 的 Spark bundle 与 S3 FileIO 插件。

			它们在**运行时**必须有（任务要执行 `CALL sys.compact`），但本模块的代码一行都不碰
			Paimon——所以既不该是 compile（那会把 Paimon 版本焊进本模块的编译契约），
			也不是 test（它确实要在运行时存在）。

			这里声明成 test 只是为了「让构建能把它们拷进 target/jars」：镜像由
			scripts/build-optimizer-image.sh 构建，而 Dockerfile 的构建上下文里有
			target/，用不到宿主机上 .m2 的绝对路径（Docker 的 COPY 不展开 ~，
			也不能从构建上下文之外取文件）。真正的运行时归属由 Dockerfile 决定。
		-->
		<dependency>
			<groupId>org.apache.paimon</groupId>
			<artifactId>paimon-spark-3.5_${scala.binary.version}</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.paimon</groupId>
			<artifactId>paimon-s3</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Iceberg 的 Spark bundle。与 Paimon 两份同样的道理：运行时必须有（任务要在
			Iceberg 表上执行 `CALL ... rewrite_data_files` / `expire_snapshots` /
			`remove_orphan_files`），但本模块的代码一行都不碰 Iceberg——语句由集群上的
			Iceberg 扩展解释。因此也不是 compile。

			它同时提供 `org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions`：
			只把 jar 放进类路径而不装这个扩展，`CALL` 会以「procedure 不存在」失败。
		-->
		<dependency>
			<groupId>org.apache.iceberg</groupId>
			<artifactId>iceberg-spark-runtime-3.5_${scala.binary.version}</artifactId>
			<version>${iceberg.version}</version>
			<scope>test</scope>
		</dependency>

		<!--
			Lance 的 Spark **bundle**（不是 lance-spark-3.5_2.12）。

			为什么必须是 bundle：薄包 `lance-spark-3.5_2.12` 只含 connector 自己的类，
			`org.lance.Dataset` / `CompactionOptions` / 原生库 / arrow 全在 `lance-core`
			及其传递依赖里。把那些一个个 COPY 进镜像，等于手工复刻一份依赖闭包，
			而且会与 Spark 发行版自带的 arrow、guava、jackson 撞版本（同名类按 jar 文件名
			排序加载，`arrow-vector-12.0.1.jar` 恰好排在 `arrow-vector.jar` 前面）。
			bundle 把这些全部 shade 进去，镜像里只多一个 jar——与 paimon-spark /
			iceberg-spark-runtime 同一个用法。

			本模块的代码一行都不碰 Lance（语句由 connector 的 parser 扩展解释），
			所以不是 compile。版本与 `TableOptimizerJob` 里写死的
			`org.lance.spark.LanceNamespaceSparkCatalog` 类名是配套的：
			0.0.x 的类名是 `com.lancedb.lance.spark...`，升版本要一起改。
		-->
		<dependency>
			<groupId>org.lance</groupId>
			<artifactId>${lance.spark.artifact}</artifactId>
			<version>${lance.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				把两种格式的运行时 jar（Paimon 两份 + Iceberg 一份）拷进 target/jars：
				镜像的构建上下文是仓库根目录，而 Docker 的 COPY 既不能取构建上下文之外的文件，
				也不展开 ~。在构建期把它们落进 target/，Dockerfile 就只需要 COPY 一个相对路径。

				`stripVersion=true` 是刻意的：文件名里不带版本，Dockerfile 才能用固定名字 COPY，
				不必再抄一份「当前版本号」。抄过——写死 `…-2.0.0.jar`，升到 2.1.0 后镜像构建
				在 COPY 处直接失败，报错 "failed to compute cache key … not found"，
				与「忘了 package」一模一样。去掉版本号还顺带解决另一个坑：target/jars 里
				残留的旧版本文件不会被误装进镜像（同名覆盖，旧名字再也引用不到）。
				本目录的 jar 名只被 Dockerfile 使用，别名不影响运行。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>copy-runtime-jars</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>test</includeScope>
							<includeArtifactIds>paimon-spark-3.5_2.12,paimon-s3,iceberg-spark-runtime-3.5_2.12,lance-spark-bundle-3.5_2.12</includeArtifactIds>
							<outputDirectory>${project.build.directory}/jars</outputDirectory>
							<stripVersion>true</stripVersion>
							<overWriteReleases>true</overWriteReleases>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				打进产品的 jar 里要有 Main-Class：容器入口是 spark-submit 指定这个类，
				而集群侧的 Spark 运行时由镜像提供（见模块目录下的 Dockerfile）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>io.github.melin.lakehouse.rest.optimizer.TableOptimizerJob</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<!--
				Spark 在 Java 17 上需要开放的 JDK 内部包，与 lakehouse-rest-spark 同一份清单。
				本模块的单元测试不建 Spark 会话（只测参数翻译），因此这份 argLine 是为了
				将来加「真跑一张表」的用例时不必再踩一遍。

				另有一道 JDK 上限：不能跑在 JDK 24+（Hadoop 的 getSubject 被 JEP 486 移除）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>
						-Djava.awt.headless=true
						--add-opens=java.base/java.lang=ALL-UNNAMED
						--add-opens=java.base/java.lang.invoke=ALL-UNNAMED
						--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
						--add-opens=java.base/java.io=ALL-UNNAMED
						--add-opens=java.base/java.net=ALL-UNNAMED
						--add-opens=java.base/java.nio=ALL-UNNAMED
						--add-opens=java.base/java.util=ALL-UNNAMED
						--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
						--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
						--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
						--add-opens=java.base/sun.nio.cs=ALL-UNNAMED
						--add-opens=java.base/sun.security.action=ALL-UNNAMED
						--add-opens=java.base/sun.util.calendar=ALL-UNNAMED
					</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
