<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		服务端世界的父 POM —— **一个依赖世界一个父**。

		为什么不让四个模块各自以 spring-boot-starter-parent 为父：
		paimon.version、将来的 iceberg.version、Boot 版本、共用插件配置都要在
		四份 POM 里各写一遍，改一处漏三处。
		为什么不让根 POM（lakehouse-rest-parent）继承 Boot 作父：那会把 Boot 的
		dependencyManagement 一并压到 Spark / optimizer 模块上，把它们的
		Jackson 2.15.2、netty、jersey 换成 Boot 的版本——轻则与集群不一致，
		重则提交任务时 NoSuchMethodError。这条早先已被明确否决过。

		名字没叫 -server-parent 是为了不与 -server 模块混淆；叫 -spring-parent 是
		直接说「它锚的是哪个依赖世界」。

		注意本模块的父 POM 从仓库解析（<relativePath/>），不是仓库根的那份聚合 POM。
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>io.github.melin</groupId>
	<artifactId>lakehouse-rest-spring-parent</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>lakehouse-rest-spring-parent</name>
	<description>服务端世界的父 POM：钉住 Spring Boot 世界的共用版本、依赖与插件</description>

	<!--
		五个服务端模块，**目录就嵌在本文件之下**。因此

		  - 这里的 <module> 写裸名字（相对本文件解析，即 `./lakehouse-rest-core`）；
		  - 各子模块的 <parent> **可以省掉 <relativePath>**——默认值 `../pom.xml`
		    恰好就是本文件。这一条是嵌套布局的直接收益：平级布局下默认值会落到仓库根
		    那份聚合 POM 上（它没有本模块的 artifactId），Maven 于是回退去仓库找父
		    POM，离线构建当场失败。

		磁盘布局（两层）：

		  lakehouse-rest-parent/                          聚合 + 集群世界的父
		  ├── pom.xml
		  ├── lakehouse-rest-spring-parent/              服务端世界的父（只有 POM）
		  │   ├── pom.xml
		  │   ├── lakehouse-rest-core/
		  │   ├── lakehouse-rest-storage/
			│   ├── lakehouse-rest-protocol-paimon/
			│   ├── lakehouse-rest-protocol-iceberg/
			│   └── lakehouse-rest-server/
		  ├── lakehouse-rest-spark/                      Spark SQL 语法扩展
		  └── lakehouse-rest-optimizer/                  表存储优化任务

		两个协议面是平级的兄弟：它们互不依赖（各自在 POM 里禁掉对方的 artifactId，
		见 §3.1 的三条不变量），共用 core 与 storage，最终在 server 的 fat jar 里会合。
		再加第三种表格式时照这个形状添一层即可。
	-->
	<modules>
		<module>lakehouse-rest-core</module>
		<module>lakehouse-rest-storage</module>
		<module>lakehouse-rest-protocol-paimon</module>
		<module>lakehouse-rest-protocol-iceberg</module>
		<module>lakehouse-rest-server</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!--
			Paimon 的版本（服务端世界）。

			锚住 paimon-core / paimon-format / paimon-s3。仓库根的聚合 POM 里
			另有一份同名属性（锚的是集群世界的 paimon-spark bundle 与 paimon-s3），
			**两处必须写同一个值**——它们决定引擎侧写出的 schema 与服务端读到的
			schema 是否是同一套。两个依赖世界不共用父 POM，这个一致性靠人工守，
			改任一处时两处一起改（仓库根 POM 的注释里有详细说明）。

			2.1.0 的迁移点（2026-10-27 从 2.0.0 升上来）：Paimon 2.1.0 把
			org.apache.paimon.schema.SchemaManager 从类改成了接口，文件系统实现改名
			FileSystemSchemaManager（构造器签名不变：(FileIO, Path)）。服务端两处
			`new SchemaManager(...)` 与两处测试夹具因此改成 `new FileSystemSchemaManager(...)`，
			其余方法（createTable / commit / latestOrThrow）都在接口上保持不变。
			再升版本时优先看这个类：它是本服务端唯一直接构造 Paimon 内部对象的地方。
		-->
		<paimon.version>2.1.0</paimon.version>
		<!--
			Iceberg 的版本（服务端世界）。

			**只有 lakehouse-rest-protocol-iceberg 会用到它**，而且它锚的是那个模块的声音：
			「本服务端实现的 Iceberg 元数据代数与哪个版本的客户端同源」。
			这与 README 里写明的支持区间是同一件事——升级它等于宣布支持更宽的客户端区间，
			两处要一起改。

			1.11.0 的选择依据是「本机随即能拿到的 Spark 客户端版本」：
			iceberg-spark-runtime-4.1_2.13 在仓库里就是 1.11.0，端到端验收用的是它。
			服务端比客户端旧会在遇到新字段时报错，比客户端新则只是多认一些字段，
			因此向上对齐而不是取「能跑就行」的更旧版本。
		-->
		<iceberg.version>1.11.0</iceberg.version>
		<!--
			Hadoop 的版本只服务一件事：**让 parquet 能读**。

			parquet-hadoop（无论是 Iceberg 面用的原生那份，还是 paimon-format 里
			relocate 过的 shade 副本）把 org.apache.hadoop.* 声明成 provided——
			它假设运行在引擎里。而 ParquetReadOptions.Builder 的构造函数里有一句
			`ParquetInputFormat.class`，加载这个类就要解析它的父类
			FileInputFormat，于是「没有 Hadoop」的表现在启动时看不见，直到第一次
			预览读数据才变成 NoClassDefFoundError（2026-10-21 线上就是这样）。

			选 hadoop-client-api + hadoop-client-runtime 而不是 hadoop-common：
			前者是 Hadoop 官方的「可嵌入」产物——第三方库（guava / protobuf /
			commons）全部 relocate 到 org.apache.hadoop.shaded.*，零传递依赖，
			因此不会与 Spring Boot / Paimon 各自的 guava 打架。代价是体积
			（19MB + 30MB）；换 hadoop-common + mapreduce-client-core 能省 40MB，
			但会把未 shaded 的 guava 27 与 protobuf 2.5 塞进类路径，那是本仓
			一直在避免的事。

			3.3.4 与 parquet 1.17.1 声明的 provided 版本（3.3.0）同一小版本线，
			也是 Spark 3.5 / Flink 1.18 实际带的版本。
		-->
		<hadoop.version>3.3.4</hadoop.version>
		<!--
			接口文档 UI：knife4j-next（`com.baizhukui`，与上游 `com.github.xiaoymin`
			是两个坐标）。Boot 4 线必须用 `-boot4-` 那个 starter——它把 springdoc
			换成 3.x；Jakarta 那个是 Boot 3.4/3.5 用的，混进来会同时命中两套
			springdoc（症状是 `/doc.html` 打开是空白页或原生 Swagger UI）。

			只是文档，不参与任何运行时判定：阅览页不进鉴权（见 WebConfig），
			端点自己的门禁一条不少。
		-->
		<knife4j.version>5.7.9</knife4j.version>
		<!--
			kubernetes 客户端（提交优化任务到各 catalog 自己的集群）。

			**锁一个具体 minor，不要改成区间**：fabric8 的 Version / Serialization
			在小版本之间发生过行为变化，而本工程的 enforcer 会拦依赖收敛问题——
			升级请当成一次独立改动，跑完全套测试再改这一个数字。

			7.8.0 对应 k8s 1.33 的 API 面；本仓只用到 batch/v1 Job、
			authorization.k8s.io/v1 的两个 review、以及 core/v1 的 Pod 与
			ServiceAccount，都是 1.20 起就稳定的资源，因此不需要跟着集群版本升。
		-->
		<fabric8.version>7.8.0</fabric8.version>
		<!--
			AWS SDK v2（只有 EKS 的令牌签名会用到 auth 这一个构件）。

			2.46.6 是 2.x 线的近期版本。**它不带 Jackson 2**：从 2.21 起
			sdk-core 改用自带的 json-utils，因此与本工程 Boot 4 的 Jackson 3
			不会出现「同一个类两条序列化栈」的经典冲突。
		-->
		<awssdk.version>2.46.6</awssdk.version>
		<!-- 依赖边界守卫，见各模块 POM 里的 bannedDependencies -->
		<enforcer.version>3.1.0</enforcer.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				本工程自己的模块。版本用 ${project.version}：这些模块只在本仓库内
				消费（没有 distributionManagement、不对外发布），因此版本号与父 POM
				一起走，避免出现「core 0.0.1 配 server 0.0.2」这种能编译但语义错的组合。
			-->
			<dependency>
				<groupId>io.github.melin</groupId>
				<artifactId>lakehouse-rest-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.melin</groupId>
				<artifactId>lakehouse-rest-storage</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.melin</groupId>
				<artifactId>lakehouse-rest-protocol-paimon</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.melin</groupId>
				<artifactId>lakehouse-rest-protocol-iceberg</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!--
				Iceberg：只有 lakehouse-rest-protocol-iceberg 会用到。
				不进 <dependencies>（那会让 core 也拿到它），也不进 spark / optimizer
				（它们是集群世界，客户端侧由 iceberg-spark-runtime 自带）。
			-->
			<dependency>
				<groupId>org.apache.iceberg</groupId>
				<artifactId>iceberg-core</artifactId>
				<version>${iceberg.version}</version>
			</dependency>
			<!--
				数据预览的读取路径（docs/table-data-preview-design.md §3）：
				  iceberg-data     GenericDeleteFilter / GenericParquetReaders 等
				                   "不依赖引擎的通用记录"实现——预览要读到与引擎一致的
				                   行（含 position / equality delete），只能走它
				  iceberg-parquet  parquet 读取（Parquet.ReadBuilder），它自己带
				                   parquet-hadoop 与 parquet-avro 1.17.1（与
				                   iceberg 1.11.0 的 pom 一致，不另立版本）
				两者都不进 <dependencies>：元数据侧（load / create / commit）用不到它们。
			-->
			<dependency>
				<groupId>org.apache.iceberg</groupId>
				<artifactId>iceberg-data</artifactId>
				<version>${iceberg.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.iceberg</groupId>
				<artifactId>iceberg-parquet</artifactId>
				<version>${iceberg.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.iceberg</groupId>
				<artifactId>iceberg-orc</artifactId>
				<version>${iceberg.version}</version>
			</dependency>

			<!-- Paimon：只有 storage（FileIO）与各协议面（元数据读写）会用到 -->
			<dependency>
				<groupId>org.apache.paimon</groupId>
				<artifactId>paimon-core</artifactId>
				<version>${paimon.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.paimon</groupId>
				<artifactId>paimon-format</artifactId>
				<version>${paimon.version}</version>
				<!--
					paimon-format 按 Hadoop 2.8.5 声明了 hadoop-common（compile），那是一份
					**又旧又带未 shaded guava 的**坐标，排除它是对的；但**排除不等于
					「不需要 Hadoop」**（2026-10-21 修正）：parquet 读路径要
					ParquetInputFormat → FileInputFormat，这类由下面的 hadoop-client-api /
					hadoop-client-runtime 提供。当时的注释写着「排除后仍能工作」，
					那句话只在**元数据读写**上成立，数据预览读 parquet 时会以
					NoClassDefFoundError: FileInputFormat 收场。
				-->
				<exclusions>
					<exclusion>
						<groupId>org.apache.hadoop</groupId>
						<artifactId>hadoop-common</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
			<!--
				parquet 读取需要的最小 Hadoop 面。声明在 dependencyManagement 里是因为
				**两个协议面都要**（Iceberg 的 parquet-hadoop 与 paimon-format 里的
				shade 副本都把它当 provided），把它写在一处才不会一边有一边漏。
				真正进可执行产物的是 server 里的那两行 runtime 依赖——哪几个面要读
				parquet 是部署决策，因此由 server 决定。
			-->
			<dependency>
				<groupId>org.apache.hadoop</groupId>
				<artifactId>hadoop-client-api</artifactId>
				<version>${hadoop.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.hadoop</groupId>
				<artifactId>hadoop-client-runtime</artifactId>
				<version>${hadoop.version}</version>
			</dependency>
			<!--
				S3 的 FileIO 插件。**运行时**必须有它，否则 warehouse 落在 s3:// 时
				StorageFileIoFactory 会以 UnsupportedSchemeException 收场——那是失败
				在第一次真正读写仓库的时刻，而不是启动时刻。

				只声明在 lakehouse-rest-server：它决定可执行产物里有哪几个 FileIO 插件，
				而 storage 模块只写「怎么用 FileIO」的代码（通过 ServiceLoader 找实现）。
			-->
			<dependency>
				<groupId>org.apache.paimon</groupId>
				<artifactId>paimon-s3</artifactId>
				<version>${paimon.version}</version>
			</dependency>

			<!--
				接口文档 UI（knife4j-next）。只声明在 lakehouse-rest-server：
				它和 springdoc 都只服务「可执行产物里有一个能读接口的页面」这一件事，
				别的模块既不该看见它们，也不该被它们拉高 springdoc 的版本。
			-->
			<dependency>
				<groupId>com.baizhukui</groupId>
				<artifactId>knife4j-openapi3-boot4-spring-boot-starter</artifactId>
				<version>${knife4j.version}</version>
			</dependency>

			<!--
				kubernetes 客户端。只声明在 lakehouse-rest-server：**只有那个模块
				service/exec 与 service/submit 里才会出现 io.fabric8.* 的 import**。
				core / storage / protocol-* 是「元数据与格式」的世界，不该知道
				任务被提交到哪里——这是本仓「执行与格式分离」的那条线的物理形态。

				用 kubernetes-client（而不是 api + httpclient-okhttp 两个坐标）：
				前者把默认的 OkHttp 实现一起带进来，且不含任何自动装配
				（fabric8 的 spring-boot-starter 才是那个会去读 ~/.kube/config 的东西，
				**绝不能引它**——那正是「静默把任务提交到服务端自己所在集群」的来源，
				见 docs/catalog-execution-cluster-design.md §8.3）。
			-->
			<dependency>
				<groupId>io.fabric8</groupId>
				<artifactId>kubernetes-client</artifactId>
				<version>${fabric8.version}</version>
			</dependency>
			<!--
				AWS SDK v2 的 auth 构件：EKS 令牌要用 Aws4Signer 预签名一个 STS URL
				（见 AwsEksTokenProvider）。

				**只给 server**：AK/SK 是「怎么连某个集群」的知识，属于执行层；
				格式面（core / storage / protocol-*）与它无关。

				排除 apache-client：那是 SDK 自己的 HTTP 客户端实现，我们从不构造
				任何 AWS 客户端（只有签名器、凭据与 Region），令牌换身份那一步走的是
				JDK 自带的 java.net.http.HttpClient。留着它等于往 fat jar 里塞一份
				没人实例化的 Apache HttpClient 5。
			-->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>auth</artifactId>
				<version>${awssdk.version}</version>
				<exclusions>
					<exclusion>
						<groupId>software.amazon.awssdk</groupId>
						<artifactId>apache-client</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!--
		服务端四个模块共用的运行时依赖。
		放在父 POM 的 <dependencies>（而不是各模块重复声明）是有意的：
		这四个模块最终进**同一个 fat jar、同一个 JVM**，所以「谁需要 webmvc」
		只影响编译期可见性，不影响产物内容。集中在这里，各模块的 POM 就只剩
		「它比别的模块多需要什么」，一眼能看出格式依赖的落点。

		**Paimon 不在这里。** 它是格式依赖，必须在具体模块里显式声明——
		否则 core 会拿到 paimon，第一条不变量当场破功（enforcer 会拦下来）。
	-->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<!--
					Lombok 的注解处理器。

					必须显式写 annotationProcessorPaths：Boot 的父 POM 只设了
					<parameters>true</parameters>，不声明处理器路径；而 JDK 23 起
					注解处理器**默认不再从类路径自动发现**，只认 -processorpath。
					不写这条，Lombok 生成的 getter/setter 会静默消失，
					报的是一堆「找不到方法」，很容易往错的方向查。
					<path> 不写版本：Boot 的 dependencyManagement 已经锚了 lombok。
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<executions>
						<execution>
							<id>default-compile</id>
							<phase>compile</phase>
							<goals>
								<goal>compile</goal>
							</goals>
							<configuration>
								<annotationProcessorPaths>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok</artifactId>
									</path>
								</annotationProcessorPaths>
							</configuration>
						</execution>
						<execution>
							<id>default-testCompile</id>
							<phase>test-compile</phase>
							<goals>
								<goal>testCompile</goal>
							</goals>
							<configuration>
								<annotationProcessorPaths>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok</artifactId>
									</path>
								</annotationProcessorPaths>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!--
					依赖边界守卫。版本与「失败即中断」的默认行为在这里钉一次，
					具体禁什么由各模块自己声明——那些规则描述的是**那个模块**的边界，
					放在它自己的 POM 里才有人看得见、改得动。
				-->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${enforcer.version}</version>
					<configuration>
						<fail>true</fail>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
