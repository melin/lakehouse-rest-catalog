<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.melin</groupId>
		<artifactId>paimon-rest-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>paimon-rest-optimizer</artifactId>
	<packaging>jar</packaging>
	<name>paimon-rest-optimizer</name>
	<description>表存储优化任务：在 k8s 上跑 Spark，按批次对多张 Paimon 表执行 compact / expire_snapshots / remove_orphan_files</description>

	<!--
		这个模块是**一个可执行程序**，不是库：它由服务端作为 k8s Job 提交
		（见 paimon-rest-server 的 KubernetesJobSubmitter），启动后自己拉批次清单、
		建一次 Spark 会话、逐表执行三个 procedure、逐表回调上报结果，然后退出。

		依赖策略与 paimon-rest-spark 一致，理由也一致：
		  - Spark / Scala 由集群提供（spark-submit 的运行时），因此 scope=provided，
		    不打进产物——否则生成的 jar 会与集群里的 Spark 版本打架；
		  - JSON 用 Spark 自带的 Jackson 2；
		  - HTTP 只用 java.net.http，不引额外客户端。

		注意本模块**没有** Paimon 依赖：三个动作都通过 `CALL` 语句执行，而 procedure
		由 Paimon 自己的 Spark 扩展与 catalog 实现落地。也就是说本模块编译期不需要
		Paimon，运行时通过集群的 `spark.sql.catalog.<name>` 配置间接用到它。
		这条边界很重要：Paimon 的 procedure 参数签名随版本变（例如 `dry_run` 在不同
		版本的参数名不同），把它写在 SQL 里、由目标集群的 Paimon 去解释，比在这里
		依赖某个版本的 Java API 更稳。
	-->

	<dependencies>
		<dependency>
			<groupId>org.scala-lang</groupId>
			<artifactId>scala-library</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-sql_${scala.binary.version}</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-catalyst_${scala.binary.version}</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>

		<!--
			slf4j 与 paimon-rest-spark 同一处坑：传递依赖里有一份 1.7.x，
			而本模块按 2.x 的 SPI 写日志。用 provided 而不是 test——provided 同时进
			主类路径与测试运行时，既能让主编译拿到 Logger，又不把绑定打进产物
			（产物跑在集群上，绑定由 spark-submit 的 log4j2 提供）。
		-->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.18</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>2.0.18</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Paimon 的 Spark bundle 与 S3 FileIO 插件。

			它们在**运行时**必须有（任务要执行 `CALL sys.compact`），但本模块的代码一行都不碰
			Paimon——所以既不该是 compile（那会把 Paimon 版本焊进本模块的编译契约），
			也不是 test（它确实要在运行时存在）。

			这里声明成 test 只是为了「让构建能把它们拷进 target/jars」：镜像由
			scripts/build-optimizer-image.sh 构建，而 Dockerfile 的构建上下文里有
			target/，用不到宿主机上 .m2 的绝对路径（Docker 的 COPY 不展开 ~，
			也不能从构建上下文之外取文件）。真正的运行时归属由 Dockerfile 决定。
		-->
		<dependency>
			<groupId>org.apache.paimon</groupId>
			<artifactId>paimon-spark-3.5_${scala.binary.version}</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.paimon</groupId>
			<artifactId>paimon-s3</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				把 Paimon 的两份运行时 jar 拷进 target/jars：镜像的构建上下文是仓库根目录，
				而 Docker 的 COPY 既不能取构建上下文之外的文件，也不展开 ~。
				在构建期把它们落进 target/，Dockerfile 就只需要 COPY 一个相对路径。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>copy-paimon-runtime</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>test</includeScope>
							<includeArtifactIds>paimon-spark-3.5_2.12,paimon-s3</includeArtifactIds>
							<outputDirectory>${project.build.directory}/jars</outputDirectory>
							<stripVersion>false</stripVersion>
							<overWriteReleases>true</overWriteReleases>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!--
				打进产品的 jar 里要有 Main-Class：容器入口是 spark-submit 指定这个类，
				而集群侧的 Spark 运行时由镜像提供（见模块目录下的 Dockerfile）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>io.github.melin.paimonrest.optimizer.TableOptimizerJob</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<!--
				Spark 在 Java 17 上需要开放的 JDK 内部包，与 paimon-rest-spark 同一份清单。
				本模块的单元测试不建 Spark 会话（只测参数翻译），因此这份 argLine 是为了
				将来加「真跑一张表」的用例时不必再踩一遍。

				另有一道 JDK 上限：不能跑在 JDK 24+（Hadoop 的 getSubject 被 JEP 486 移除）。
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>
						-Djava.awt.headless=true
						--add-opens=java.base/java.lang=ALL-UNNAMED
						--add-opens=java.base/java.lang.invoke=ALL-UNNAMED
						--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
						--add-opens=java.base/java.io=ALL-UNNAMED
						--add-opens=java.base/java.net=ALL-UNNAMED
						--add-opens=java.base/java.nio=ALL-UNNAMED
						--add-opens=java.base/java.util=ALL-UNNAMED
						--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
						--add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED
						--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
						--add-opens=java.base/sun.nio.cs=ALL-UNNAMED
						--add-opens=java.base/sun.security.action=ALL-UNNAMED
						--add-opens=java.base/sun.util.calendar=ALL-UNNAMED
					</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
