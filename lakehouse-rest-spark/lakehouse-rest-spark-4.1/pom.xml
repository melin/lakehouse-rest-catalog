<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.melin</groupId>
		<artifactId>lakehouse-rest-spark-parent</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>lakehouse-rest-spark-4.1</artifactId>
	<packaging>jar</packaging>
	<name>lakehouse-rest-spark-4.1</name>
	<description>Spark 4.1 / Scala 2.13 的 Spark SQL 管理语法扩展</description>

	<!--
		与 -3.5 同构：代码在 ../shared/ 下共用，本模块只负责「用 4.1 的工具链把它编出来」。
		依赖清单与 -3.5 逐条对应（为什么每条都要，见那边的注释），差别只有下面五个属性
		与一个版本差异类。改依赖时两个模块要一起改——它们必须是同一份清单的两次编译，
		否则两个版本的行为会悄悄分叉。
	-->

	<properties>
		<!--
			这四个与 -3.5 是一组：Spark 版本、Scala 版本、Scala 二进制版本、ANTLR。
			4.1 用 Scala 2.13.17（与 spark-sql_2.13:4.1.2 的 scala-library 一致），
			ANTLR 用 4.13.1（Spark 4.1.2 自带的 antlr4-runtime 版本）。
			两者写错都只在运行期暴露，见父 POM 的说明。
		-->
		<spark.version>4.1.2</spark.version>
		<scala.version>2.13.17</scala.version>
		<scala.binary.version>2.13</scala.binary.version>
		<antlr.runtime.version>4.13.1</antlr.runtime.version>

		<!--
			Iceberg 有 4.1 的 bundle，直接对齐。
		-->
		<iceberg.spark.artifact>iceberg-spark-runtime-4.1_2.13</iceberg.spark.artifact>

		<!--
			**必须覆盖根 POM 的 Jackson 钉版。**

			根 POM 的 dependencyManagement 把 `jackson-databind` 钉在 2.15.2——那是
			Spark 3.5 的版本，写成全局钉版是为了让 3.5 侧的 JSON 编解码与发行版逐字一致。
			这个钉版对 4.1 是错的：Spark 4.1.2 用 Jackson 2.21.2，其
			`jackson-module-scala` 在初始化时会校验 databind 的主次版本：

			  Scala module 2.21.2 requires Jackson Databind version >= 2.21.0 and < 2.22.0
			  - Found jackson-databind version 2.15.2
			    at org.apache.spark.rdd.RDDOperationScope$.<clinit>

			症状是**会话能建起来、普通 SELECT 也能过**，但任何走 ParseException 或
			RDDOperationScope 的路径都炸（本模块实测是 4 个用例），离「Jackson 被降级」
			很远。因此这里把它覆盖成 4.1 的版本，而不是去改根 POM——根 POM 还要服务 3.5。
		-->
		<jackson2.version>2.21.2</jackson2.version>

		<!--
			Paimon 2.0.0 没有 Spark 4.1 的 bundle（只有 paimon-spark-4.0_2.13），当时借它
			顶了一段时间；**2.1.0 起有了 paimon-spark-4.1_2.13**，已换回原生那份。
			换回的意义不只是「名实相符」：4.0 的 bundle 里嵌的是 Spark 4.0 的
			shade 产物，与 4.1 的 catalyst 在同一会话里混用时，个别 plan 节点的
			class identity 会对不上（本模块当初为此跳过了若干 Paimon 用例）。
		-->
		<paimon.spark.artifact>paimon-spark-4.1_2.13</paimon.spark.artifact>

		<!--
			Lance 的 Spark bundle 在这一版是 `4.1_2.13`（根 POM 的默认值是 3.5 那份）。

			覆盖而不是让根 POM 用 `spark.version` 拼：根 POM 的 `spark.version` 描述的是
			3.5（那边才是默认构建），本模块的属性块里才改成 4.1.2，所以构件名的
			Spark / Scala 段在这里必须显式写死。
		-->
		<lance.spark.artifact>lance-spark-bundle-4.1_2.13</lance.spark.artifact>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.scala-lang</groupId>
			<artifactId>scala-library</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-sql_${scala.binary.version}</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-catalyst_${scala.binary.version}</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4-runtime</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>io.github.melin</groupId>
			<artifactId>lakehouse-rest-spark-common</artifactId>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Lance 的 Spark bundle：**只用于测试**，与 3.5 模块那条对应（为什么必须是
			bundle 而不是薄包，见那边的注释）。

			4.1 这一份存在的意义：`LanceCatalogLiveTests` 是同一份共享源码，两个模块
			都要能用真 connector 跑。构件名里的 Spark / Scala 段是死的
			（`lance-spark-bundle-4.1_2.13`），由 `lance.spark.artifact` 指过来。

			与 3.5 的两处差别（都是**实测过**的，不是推的）：

			<ul>
			  <li>**不需要给 `spark-catalyst` 加 arrow 排除**。Spark 4.1.2 自带
			      arrow 18.3.0（`provided`，本来就排在 bundle 前面），0.8.0 的 bundle
			      里 shade 的是 15.0.2；两者同场跑过 7 个用例（含写入与 OPTIMIZE，
			      都真的走 arrow），没有出现 3.5 那边 `MemoryUtil` 的
			      `UnsupportedOperationException`。既然不炸就不动它——4.1 的
			      ArrowConverters 仍在用 Spark 自己那份 arrow，摘掉风险更大；</li>
			  <li>**不涉及 `NamedArgument` 冲突**。Spark 4.1 的 `spark-catalyst` 本身
			      就有这个类，而 0.8.0 的 bundle 不再自带（3.5 那份也不带了）——
			      0.4.0 时那处 `NoSuchMethodError` 的来源已经消失。</li>
			</ul>

			排序仍与 3.5 一致（在 Paimon / Iceberg 之前）：让两个模块的依赖清单保持
			「逐条对应」的形状，改一处时不会漏另一处。
		-->
		<dependency>
			<groupId>org.lance</groupId>
			<artifactId>${lance.spark.artifact}</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.apache.paimon</groupId>
			<artifactId>${paimon.spark.artifact}</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.paimon</groupId>
			<artifactId>paimon-s3</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.iceberg</groupId>
			<artifactId>${iceberg.spark.artifact}</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Iceberg 的 S3 FileIO 依赖（AWS SDK v2 的 shade 包）。
			与 3.5 模块同一条、同一个理由：bundle 里有 S3FileIO，没有 awssdk；
			缺它时 `s3://` 写入会在 `ResolvingFileIO` 静默回退之后才炸，
			报错离原因两跳远（详见根 POM 里这条依赖的说明）。
		-->
		<dependency>
			<groupId>org.apache.iceberg</groupId>
			<artifactId>iceberg-aws-bundle</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.spark</groupId>
			<artifactId>spark-hive_${scala.binary.version}</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<version>2.0.18</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<version>2.0.18</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>antlr</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>antlr4</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<sourceDirectory>${project.basedir}/../shared/src/main/antlr4</sourceDirectory>
					<visitor>true</visitor>
					<listener>false</listener>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-shared-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../shared/src/main/scala</source>
							</sources>
						</configuration>
					</execution>
					<execution>
						<id>add-shared-test-sources</id>
						<phase>generate-test-sources</phase>
						<goals>
							<goal>add-test-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../shared/src/test/scala</source>
							</sources>
						</configuration>
					</execution>
					<execution>
						<id>add-shared-test-resources</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>add-test-resource</goal>
						</goals>
						<configuration>
							<resources>
								<resource>
									<directory>${project.basedir}/../shared/src/test/resources</directory>
								</resource>
							</resources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>net.alchim31.maven</groupId>
				<artifactId>scala-maven-plugin</artifactId>
				<configuration>
					<args>
						<arg>-deprecation</arg>
						<arg>-feature</arg>
						<!--
							共享源码用 `scala.collection.JavaConverters._`：这个名字在 2.12 是标准
							写法，2.13 只是把它改名成 `scala.jdk.CollectionConverters`（旧的仍保留）。
							两个版本编译同一份源码时只能用旧名字，否则 3.5 编不过。因此这里只静音
							这一条警告——不是关掉 deprecation，其它弃用照常报。
						-->
						<arg>-Wconf:cat=deprecation&amp;msg=JavaConverters:s</arg>
					</args>
				</configuration>
				<executions>
					<execution>
						<id>scala-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
					</execution>
					<execution>
						<id>scala-test-compile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
