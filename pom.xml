<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>io.github.melin</groupId>
	<artifactId>lakehouse-rest-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>lakehouse-rest-parent</name>
	<description>湖仓 REST Catalog 服务端、Spark SQL 扩展与表优化任务</description>

	<!--
		聚合三类东西，对应**两个依赖世界**：

		  服务端世界（Spring Boot）—— 由 lakehouse-rest-spring-parent 再聚合：
		    lakehouse-rest-core              领域与共享契约（零格式依赖）
		    lakehouse-rest-storage           对象存储访问（warehouse 的读写都从这里出）
		    lakehouse-rest-protocol-paimon   LakeHouse Catalog 协议面
		    lakehouse-rest-server            可执行：装配 / 管理 API / 控制台宿主
		    （后续迭代再加 lakehouse-rest-protocol-iceberg）

		  集群世界（Spark 由集群提供）—— 与上面共用本 POM 作父：
		    lakehouse-rest-spark-parent      Spark 侧的聚合：一份源码、按 3.5 / 4.1 出两个产物
		      ├── lakehouse-rest-spark-common   REST 客户端（纯 Java，两版共用）
		      ├── lakehouse-rest-spark-3.5      Spark 3.5 / Scala 2.12
		      └── lakehouse-rest-spark-4.1      Spark 4.1 / Scala 2.13
		    lakehouse-rest-optimizer         表存储优化任务：由服务端作为 k8s Job 提交

		聚合与继承在这里刻意分开：
		  - 本 POM 只是聚合器，同时是 lakehouse-rest-spark-parent 与 lakehouse-rest-optimizer 的父 POM；
		  - 服务端四个模块的父 POM 是 lakehouse-rest-spring-parent（它继承
		    spring-boot-starter-parent）。**那四个模块的目录就嵌在 spring-parent/ 里面**，
		    所以那边只需要本 POM 当聚合器、不需要再指点父 POM 的位置；
		    也因此 `-pl` 要写坐标形式 `-pl :lakehouse-rest-server`——裸名字会被当成相对路径。

		如果把 spring-boot-starter-parent 提为本 POM 的父，它带来的
		dependencyManagement 会一并作用到 Spark 模块上——例如把 Spark 依赖的
		Jackson 2.15.2 抬到 Boot 管理的 2.21.x、把 netty / jersey 换成 Boot 的版本，
		轻则类路径与集群不一致，重则在提交任务时 NoSuchMethodError。
		两个模块的依赖世界本来就不同，因此不共用父 POM，只共用聚合。

		lakehouse-rest-optimizer 与 lakehouse-rest-spark-* 属同一个依赖世界（Spark 由集群提供、
		Jackson 对齐发行版），因此共用父 POM 是安全的。注意 Jackson 的钉版是 2.15.2
		（Spark 3.5 的版本），4.1 模块在自己的 POM 里覆盖了它——见
		docs/maven-module-design.md §13.1。

		模块清单与依赖方向见 docs/maven-module-design.md；三条不变量
		（core 无格式依赖 · 两个协议面互不依赖 · iceberg-core 只在本格式面）
		由各模块 POM 的 maven-enforcer bannedDependencies 机械守住。
	-->
	<modules>
		<module>lakehouse-rest-spring-parent</module>
		<module>lakehouse-rest-spark</module>
		<module>lakehouse-rest-flink</module>
		<module>lakehouse-rest-optimizer</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>17</maven.compiler.release>

		<!-- Spark 侧：与 Paimon / Iceberg 在 Spark 3.5 上的常用部署组合一致 -->
		<spark.version>3.5.9</spark.version>
		<scala.version>2.12.18</scala.version>
		<scala.binary.version>2.12</scala.binary.version>
		<!--
			与 Spark 3.5.x 自带版本对齐：ANTLR 运行时、Jackson 2。

			ANTLR 必须**精确**等于 Spark 发行版里的 antlr4-runtime 版本。
			Spark 3.5.9 的 spark-sql-api 依赖 antlr4-runtime 4.9.3，其自带的
			SqlBaseLexer/SqlBaseParser 是用 4.9.3 生成的（ATN 序列化版本 3）。
			如果这里写更高的版本（例如 4.13.x，其 ATN 序列化版本为 4），运行时会把
			Spark 自己的 antlr4-runtime 顶掉，于是 Spark 连普通 SQL 都解析不了：

			  InvalidClassException: org.antlr.v4.runtime.atn.ATN;
			  Could not deserialize ATN with version 3 (expected 4)
			    at org.apache.spark.sql.catalyst.parser.SqlBaseLexer.<clinit>

			也就是说 ANTLR 版本写错，受损的不是本扩展，而是整个会话的 SQL 解析。
			升级 spark.version 时必须同步核对这个值。
		-->
		<antlr.runtime.version>4.9.3</antlr.runtime.version>
		<jackson2.version>2.15.2</jackson2.version>
		<junit.version>6.0.3</junit.version>
		<!--
			Paimon 的版本（集群世界）。

			只用于 lakehouse-rest-spark / lakehouse-rest-optimizer 的**测试**与镜像打包：
			建表用例需要真实的 Paimon Spark 目录来验证「Spark SQL 能否按我们的
			REST 契约建出表」，而这两个模块自身运行时不编译 Paimon。

			构件名带 Scala 二进制版本后缀（`paimon-spark-3.5_2.12`），
			因此与 spark.version / scala.binary.version 是绑定的：
			换 Spark 或 Scala 版本时必须同步换这里。

			**服务端世界另有一份同名属性**（lakehouse-rest-spring-parent 的
			paimon.version，锚的是 paimon-core / paimon-format / paimon-s3）。
			两处必须写同一个值：它们决定「引擎侧把 schema 写成什么样」与
			「服务端把 schema 读成什么样」是否一致，不一致的症状是引擎侧报
			UnsupportedOperationException，或者读到缺列的 schema。
			两个依赖世界不共用父 POM，所以这个一致性目前靠人工守——
			改任一处时两处一起改（见 docs/maven-module-design.md §3.2）。
		-->
		<paimon.version>2.0.0</paimon.version>

		<!--
			Iceberg 的版本（集群世界）。

			只用于 `lakehouse-rest-spark` / `lakehouse-rest-optimizer` 的**测试**：
			`CREATE TABLE ... USING iceberg` 要由 Iceberg 自己的 Spark catalog 执行，
			optimizer 侧的三个优化动作也靠它提供的 procedures。两个模块自身运行时
			都不编译 Iceberg。

			**必须与 spring-parent 的 iceberg.version 一致**：服务端用 iceberg-core
			写/读元数据，引擎侧用 Spark bundle 生成/消费同一份元数据；版本不一致时
			新写入的元数据（例如 v3 的 next-row-id）可能被旧运行时读不懂。
			两个依赖世界不共用父 POM，一致性靠人工守（见 docs/maven-module-design.md §3.2）。
		-->
		<iceberg.version>1.11.0</iceberg.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.scala-lang</groupId>
				<artifactId>scala-library</artifactId>
				<version>${scala.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.spark</groupId>
				<artifactId>spark-sql_${scala.binary.version}</artifactId>
				<version>${spark.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.spark</groupId>
				<artifactId>spark-catalyst_${scala.binary.version}</artifactId>
				<version>${spark.version}</version>
			</dependency>
			<dependency>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-runtime</artifactId>
				<version>${antlr.runtime.version}</version>
			</dependency>
			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-databind</artifactId>
				<version>${jackson2.version}</version>
			</dependency>
			<!--
				Paimon 的 Spark bundle，自带 paimon-core / 文件系统实现 / 依赖 shade。
				测试用，见 lakehouse-rest-spark/pom.xml 的说明。
			-->
			<dependency>
				<groupId>org.apache.paimon</groupId>
				<artifactId>paimon-spark-3.5_${scala.binary.version}</artifactId>
				<version>${paimon.version}</version>
			</dependency>
			<!--
				S3 的 FileIO 实现。

				引擎侧要与「warehouse 在对象存储上」的 catalog 打交道，类路径里就必须有
				对应 scheme 的 FileIO：`paimon-spark` bundle 只带了本地文件系统与 Hadoop
				回退，遇到 `s3://` 会以
				`UnsupportedSchemeException: Could not find a file io implementation for
				scheme 's3'` 收场。测试与生产同理，只是生产上这份 jar 由发行版提供
				（放进 `spark/jars`），测试期得自己声明。

				为什么整份引入而不是只挑 impl：`paimon-s3` 是 Paimon 约定的部署单元——
				顶层只有 `org.apache.paimon.s3.S3Loader` 与 SPI 声明，真正的实现连同
				shade 过的 hadoop-aws 一起放在 jar 内的 `paimon-plugin-s3/` 下，
				由 `PluginFileIO` 用自己的类加载器加载，因此**不会**与类路径上的
				Hadoop / Jackson 相互覆盖。代价是这份 jar 很大（约 96 MB），
				但它是 test scope，不进产物。
			-->
			<dependency>
				<groupId>org.apache.paimon</groupId>
				<artifactId>paimon-s3</artifactId>
				<version>${paimon.version}</version>
			</dependency>
			<!--
				Paimon 的 Spark 扩展在初始化时引用 spark-hive 里的 HiveUDFExpressionBuilder
				（Spark 发行版自带 spark-hive，因此提交到集群时天然可用）。
				直接跑 JUnit 时没有这份 jar，会话会初始化失败，故测试期显式引入。
			-->
			<dependency>
				<groupId>org.apache.spark</groupId>
				<artifactId>spark-hive_${scala.binary.version}</artifactId>
				<version>${spark.version}</version>
			</dependency>
			<!--
				Iceberg 的 Spark bundle，测试用（见 lakehouse-rest-spark/pom.xml 的说明）。

				构件名带 Scala 二进制版本后缀，与 spark.version / scala.binary.version 绑定：
				换 Spark 或 Scala 版本时这里要跟着换（Spark 4 / Scala 2.13 对应
				`iceberg-spark-runtime-4.1_2.13`）。
			-->
			<dependency>
				<groupId>org.apache.iceberg</groupId>
				<artifactId>iceberg-spark-runtime-3.5_${scala.binary.version}</artifactId>
				<version>${iceberg.version}</version>
			</dependency>
			<!--
				Iceberg 的 AWS 支持包：`iceberg-aws` 连同 AWS SDK v2（含一个同步
				HTTP 客户端实现）一起 shade 进来的部署单元。

				**它是独立于上面那个 bundle 的第二份 jar**，原因在 Iceberg 的打包方式：
				`iceberg-spark-runtime` 里**有** `org.apache.iceberg.aws.s3.S3FileIO`，
				但**没有** `software.amazon.awssdk.*`——Iceberg 把 AWS SDK 当 compileOnly，
				由使用者自己提供。于是 `s3://` 上建表时的报错是
				`Cannot find constructor for interface org.apache.iceberg.io.FileIO
				 Missing org.apache.iceberg.aws.s3.S3FileIO
				 [NoClassDefFoundError: software/amazon/awssdk/core/exception/SdkException]`，
				接着 `ResolvingFileIO` 只打一行 WARN 就**静默回退到 HadoopFileIO**
				（它同样不认 `s3://`，真正的失败要再往后两跳才爆出来）。
				也就是说：缺这个 jar 的报错指向的地方，离真正缺的依赖有两跳远。

				与 `paimon-s3` 是对称的两份，但**互不通用**：Paimon 的那份以插件形式
				自带 shade 过的 hadoop-aws，Iceberg 走的是自己的 iceberg-aws + awssdk。

				版本与 `iceberg.version` 同一个值：bundle 里的 iceberg-aws 与服务端
				iceberg-core 是同一份发布，拆开会有两边元数据/客户端行为不一致的风险。
			-->
			<dependency>
				<groupId>org.apache.iceberg</groupId>
				<artifactId>iceberg-aws-bundle</artifactId>
				<version>${iceberg.version}</version>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter</artifactId>
				<version>${junit.version}</version>
			</dependency>
			<!--
				surefire 3.x 自己也会去解析 junit-platform-launcher；
				显式声明可以让离线构建拿到确定版本，而不是依赖 surefire 的默认探测。
			-->
			<dependency>
				<groupId>org.junit.platform</groupId>
				<artifactId>junit-platform-launcher</artifactId>
				<version>${junit.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!--
		本 POM 没有父 POM，因此核心插件的版本需要自己钉住，
		否则会退回 Maven 内置的默认版本，构建结果依赖本机 Maven 版本。

		服务端世界（spring-parent 及其五个模块）的插件版本由
		spring-boot-starter-parent 提供，不在这里重复钉。
	-->
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.15.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.6</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
